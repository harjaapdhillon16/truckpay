# ── Agent Connect (NEAR Intents Agent API) ───────────────────────────────────────────────────
# Create a key in the partner dashboard. Without it the app runs a local simulation of the wallet.
# WARNING: the hosted API is mainnet with real funds.
NEAR_INTENTS_AGENT_API_KEY=
NEAR_INTENTS_AGENT_API_URL=https://api.demo.agentsonintents.com
# Force simulation even when a key is set: AGENT_CONNECT_MODE=simulated
AGENT_CONNECT_MODE=

# Broker owner key (EVM, hex). Signs each load wallet's policy and the agent grant (EIP-712).
# Leave empty to auto-generate one into ./data on first run. Use a dedicated key with no funds.
BROKER_OWNER_EVM_PRIVATE_KEY=

# Asset the load wallets hold and pay in (default: USDC on Base as a NEAR Intents asset id).
PAYOUT_ASSET=nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
PAYOUT_ASSET_SYMBOL=USDC
PAYOUT_ASSET_DECIMALS=6
# Asset the broker sends to the deposit address (defaults to PAYOUT_ASSET).
FUNDING_ORIGIN_ASSET=

# Contract dollars × scale = on-chain USDC. 0.001 turns a $2,500 load into 2.50 USDC. 1 = real size.
SETTLEMENT_SCALE=0.001

# ── Proof verification (Claude vision) ───────────────────────────────────────────────────────
# Without a key the agent runs the deterministic checks only (geofence, files present, caps).
ANTHROPIC_API_KEY=
VERIFIER_MODEL=claude-opus-5-5

# Public origin for driver links (e.g. an ngrok/cloudflared URL so a phone can open it).
PUBLIC_URL=
