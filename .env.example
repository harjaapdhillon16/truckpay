# Copy to .dev.vars (NOT .env.local: next build bundles .env* files into the Worker).
# `npm run demo:keys` fills in the generated values below.
# On Cloudflare, secrets are Worker secrets and the rest are vars in wrangler.jsonc.

# Agent Connect (NEAR Intents Agent API). An `naa_…` key from the Agent API partner dashboard.
# Without it the wallet is simulated. Mainnet, real funds.
NEAR_INTENTS_AGENT_API_KEY=
AGENT_CONNECT_MODE=

# Proof review with Claude. Without it every proof goes to the company for review.
ANTHROPIC_API_KEY=

# Generated by `npm run demo:keys`
BROKER_OWNER_EVM_PRIVATE_KEY=
COMPANY_REFUND_NEAR_ACCOUNT=
COMPANY_REFUND_NEAR_SEED_HEX=
COMPANY_REFUND_BASE_ADDRESS=
COMPANY_REFUND_BASE_PRIVATE_KEY=
DEMO_CARRIER_BASE_ADDRESS=
DEMO_CARRIER_BASE_PRIVATE_KEY=
DEMO_CARRIER_NEAR_ACCOUNT=
DEMO_CARRIER_NEAR_SEED_HEX=
GRANT_SEALING_KEY=

TICK_SECRET=
