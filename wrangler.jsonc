{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loadwallet",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "loadwallet" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loadwallet-db",
      "database_id": "cdf3a6e3-2918-4289-a813-7bd93f83aa8f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PROOFS", "bucket_name": "loadwallet-proofs" }],
  // Every minute: advance wallet setups, deposits, verifications and payments nobody is watching.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "NEAR_INTENTS_AGENT_API_URL": "https://api.demo.agentsonintents.com",
    "PAYOUT_ASSET": "nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near",
    "SETTLEMENT_SCALE": "0.001",
    "VERIFIER_MODEL": "claude-opus-5-5",
    "DEMO_FEATURES": "true",
    // Real Agent Connect wallets, no real USDC: deposits simulated, payouts quoted. Set "false" to move real funds.
    "TEST_MONEY": "true",
    "COMPANY_REFUND_NEAR_ACCOUNT": "f07fdf51c02bb817f47b5694d6532bb43071fc423b34326694db21a3c2f67bbc",
    "DEMO_CARRIER_BASE_ADDRESS": "0x9817cdf87e886c3082852e042627a9904124485d",
    "DEMO_CARRIER_NEAR_ACCOUNT": "024774bd108d607b9a66c5b96f5f6366565d6ddd67519d0305f82fb8c1194494"
  }
}
